/**
 * @vitest-environment node
 */

import { beforeEach, describe, expect, it } from "vitest";

import { prisma } from "@/lib/db/prisma";

import {
  create{{pascalCase entityName}},
  find{{pascalCase pluralName}},
} from "./{{kebabCase entityName}}.repository";

import { create{{pascalCase entityName}}Schema } from "./{{kebabCase entityName}}.schema";

describe("{{pascalCase entityName}}", () => {
  let tenantAId: string;
  let tenantBId: string;

  beforeEach(async () => {
    await prisma.{{camelCase entityName}}.deleteMany();

    await prisma.tenant.deleteMany();

    const tenantA = await prisma.tenant.create({
      data: {
        name: "Tenant A",
      },
    });

    const tenantB = await prisma.tenant.create({
      data: {
        name: "Tenant B",
      },
    });

    tenantAId = tenantA.id;
    tenantBId = tenantB.id;
  });

  describe("schema", () => {
    it("accepts valid data", () => {
      const result = create{{pascalCase entityName}}Schema.safeParse({
        name: "Exemplo",
        description: "Descrição",
        duration: 30,
        price: 50,
        active: true,
      });

      expect(result.success).toBe(true);
    });

    it("rejects invalid data", () => {
      const result = create{{pascalCase entityName}}Schema.safeParse({
        name: "",
        description: "",
        duration: 0,
        price: -10,
        active: true,
      });

      expect(result.success).toBe(false);
    });
  });

  describe("repository", () => {
    it("creates and lists a {{camelCase entityName}}", async () => {
      await create{{pascalCase entityName}}(tenantAId, {
        name: "Exemplo",
        description: "Descrição",
        duration: 30,
        price: 50,
        active: true,
      });

      const result = await find{{pascalCase pluralName}}(tenantAId, {
        search: "",
        page: 1,
        pageSize: 20,
        sortBy: "name",
        sortDirection: "asc",
      });

      expect(result.total).toBe(1);
      expect(result.items).toHaveLength(1);
      expect(result.items[0]).toMatchObject({
        name: "Exemplo",
        duration: 30,
        price: "50",
        active: true,
      });
    });

    it("isolates {{camelCase pluralName}} by tenant", async () => {
      await create{{pascalCase entityName}}(tenantAId, {
        name: "Registro A",
        description: "",
        duration: 30,
        price: 50,
        active: true,
      });

      await create{{pascalCase entityName}}(tenantBId, {
        name: "Registro B",
        description: "",
        duration: 45,
        price: 70,
        active: true,
      });

      const result = await find{{pascalCase pluralName}}(tenantAId, {
        search: "",
        page: 1,
        pageSize: 20,
        sortBy: "name",
        sortDirection: "asc",
      });

      expect(result.total).toBe(1);
      expect(result.items).toHaveLength(1);
      expect(result.items[0].name).toBe("Registro A");
    });
  });
});