  };

  const [{{camelCase pluralName}}, total] = await prisma.$transaction([
    prisma.{{camelCase pluralName}}.findMany({
      where,
      orderBy,
      skip: (page - 1) * pageSize,
      take: pageSize,
      select: {{camelCase entityName}}Select,
    }),

    prisma.{{camelCase pluralName}}.count({
      where,
    }),
  ]);

  const items: {{pascalCase entityName}}ListItem[] =
    {{camelCase pluralName}}.map(({{camelCase entityName}}) => ({
      id: {{camelCase entityName}}.id,
      name: {{camelCase entityName}}.name,
